# Copy to .env, put your real key there (never commit .env). Run with: uv run --env-file .env ...
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_CALLS_PER_MINUTE=10
# Optional: US dollars per million tokens, from Google's pricing page, so the usage report can
# show a cost (uv run python -m flame_in_freefall.usage). Leave them out and it shows tokens only.
# GEMINI_USD_PER_M_INPUT=
# GEMINI_USD_PER_M_OUTPUT=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO
